<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Pscx.Time</RootNamespace>
    <AssemblyName>Pscx.Time</AssemblyName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Dan Luca</Company>
    <Authors>Dan Luca</Authors>
    <Copyright>Copyright © 2026 Dan Luca</Copyright>
    <RepositoryUrl>git@github.com:danluca/Pscx.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Title>PSCX time extensions</Title>
    <Description>Optional NodaTime-backed types and accelerators for PowerShell Core Community Extensions</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NodaTime" Version="3.3.3" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Pscx.Time.psd1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Pscx.Time.psm1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyNodaTimePayload" AfterTargets="Build">
    <Copy SourceFiles="$(PkgNodatime)/lib/net8.0/NodaTime.dll" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(PkgNodatime)/lib/net8.0/NodaTime.xml" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
