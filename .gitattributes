#
# https://help.github.com/articles/dealing-with-line-endings/
#
# These are explicitly windows files and should use crlf
*.bat           text eol=crlf

# Authenticode signatures cover the exact file bytes. Do not allow Git's text
# conversion (including core.autocrlf) to rewrite signed PowerShell content.
*.ps1           -text
*.psm1          -text
*.psd1          -text
*.ps1xml        -text

